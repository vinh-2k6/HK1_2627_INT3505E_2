{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hotel",
  "type": "object",
  "properties": {
    "hotel_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "description": {
      "type": ["string", "null"]
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["hotel_id", "name", "address", "city"]
}