{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Booking",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "room_type_id": {
      "type": "string",
      "format": "uuid"
    },
    "check_in_date": {
      "type": "string",
      "format": "date"
    },
    "check_out_date": {
      "type": "string",
      "format": "date"
    },
    "total_amount": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "CONFIRMED", "CANCELLED"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["booking_id", "user_id", "room_type_id", "check_in_date", "check_out_date", "total_amount", "status"]
}